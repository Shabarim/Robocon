float custommap(float value, float frommin, float frommax, float tomin, float tomax) {
  float v = value - frommin;
  float v1 = (v / (frommax - frommin)) * 100;
  float v2 = (v1 / 100) * (tomax - tomin);
  float v3 = v2 + tomin;
  return v3;}

int potpin = A0;
int led1 = 5;
int led2 = 6; 

void setup() {
  pinMode(potpin, INPUT);
  pinMode(led1, OUTPUT);
  pinMode(led2, OUTPUT);
}

void loop() {
  float potValue = (float)analogRead(potpin);
  float brightness1f = custommap(potValue, 0.0, 1023.0, 0.0, 255.0);
  int brightness1 = (int)brightness1f;
  int brightness2 = 255 - brightness1;
  analogWrite(led1, brightness1);
  analogWrite(led2, brightness2);
}
