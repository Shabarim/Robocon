int pot = A0;
int ena = 5;
int in3 = 4;
int in4 = 3;
void setup() {
pinMode(ena, OUTPUT);
pinMode(in3, OUTPUT);
pinMode(in4, OUTPUT);
pinMode(pot, INPUT);
}
void loop() {
int potval= analogRead(pot);
int motor = map(potval, 0, 1023, 0, 255);
digitalWrite(in3, HIGH);
digitalWrite(in4, LOW);
analogWrite(ena, motor);
}
